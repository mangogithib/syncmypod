# ---- Database -------------------------------------------------------------
DB_USER=syncmypod
DB_NAME=syncmypod
# Required. Generate one:  openssl rand -hex 24
DB_PASSWORD=

# ---- Web app --------------------------------------------------------------
# Required. Signs session cookies. Generate one:  openssl rand -hex 32
SESSION_SECRET=

# Where the app listens on the host.
#   127.0.0.1   -> this machine only (default)
#   10.x.x.x    -> a private network address, reachable only on that network
#   0.0.0.0     -> every interface. Only do this behind HTTPS.
BIND_ADDR=127.0.0.1
HOST_PORT=3010

# The externally visible base URL, e.g. https://pod.example.com. Used to build
# the Spotify OAuth redirect and the pairing details shown to the local app.
# Leave blank and the app infers it from the request, which is fine for testing.
PUBLIC_URL=

# Who may speak for someone else via X-Forwarded-For. This is a security
# setting: whatever is trusted here becomes the address the rate limiter counts
# against, so trusting too much lets a client rotate its apparent IP and walk
# past the login limiter.
#
#   0                          no proxy - trust nothing (default)
#   172.16.0.0/12              trust only peers in that range, e.g. the bundled
#                              Caddy on the Docker network. PREFERRED.
#   1                          trust one hop. Only safe when the app is
#                              reachable ONLY through the proxy.
TRUST_PROXY=0

# ---- Public HTTPS on your own domain (optional) ---------------------------
# Only needed for:  docker compose --profile public up -d --build
# Without this profile the app is reachable only on BIND_ADDR above.
#
# The bare hostname - no scheme, no port.
PUBLIC_HOSTNAME=
# The port the public HTTPS listener uses. Must be open inbound in your
# firewall AND in your cloud provider's security rules.
PUBLIC_PORT=8444
# DuckDNS token, from https://www.duckdns.org. Used only for the DNS-01
# certificate challenge, which is what allows a real certificate without
# needing inbound port 80 or 443.
DUCKDNS_TOKEN=
# Where Let's Encrypt sends renewal-failure warnings. REQUIRED for the public
# profile - Caddy refuses to start without it.
ACME_EMAIL=
# Leave at 0 until you have confirmed the certificate works, then set to
# 31536000. HSTS is a promise browsers remember, with no quick undo.
HSTS_MAX_AGE=0
CADDY_MEM_LIMIT=256m

# ---- Spotify (optional but strongly recommended) --------------------------
# Create an app at https://developer.spotify.com/dashboard
# Client credentials alone enable search + metadata resolution.
# Adding the redirect URI below also enables importing your own playlists.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI registered on the Spotify app exactly.
# Typically: <PUBLIC_URL>/api/import/spotify/callback
SPOTIFY_REDIRECT_URI=

# Optional two-letter market (e.g. GB, IN, US). Leave blank unless a specific
# market gives better matches for your library. Blank means Spotify returns
# everything, which is normally right here: this tool only reads metadata, so
# whether a track is playable in a given country does not matter.
SPOTIFY_MARKET=

# ---- MusicBrainz (fallback provider) --------------------------------------
# MusicBrainz requires a contactable User-Agent. An email or a project URL.
MUSICBRAINZ_CONTACT=

# ---- Resource ceilings ----------------------------------------------------
APP_MEM_LIMIT=512m
DB_MEM_LIMIT=512m
DB_SHM_SIZE=256m
