# ---- Database -------------------------------------------------------------
DB_USER=syncmypod
DB_NAME=syncmypod
# Required. Generate one:  openssl rand -hex 24
DB_PASSWORD=

# ---- Web app --------------------------------------------------------------
# Required. Signs session cookies. Generate one:  openssl rand -hex 32
SESSION_SECRET=

# Where the app listens on the host.
#   127.0.0.1   -> this machine only (default)
#   100.x.x.x   -> a Tailscale/VPN address, reachable only on that network
#   0.0.0.0     -> every interface. Only do this behind HTTPS.
BIND_ADDR=127.0.0.1
HOST_PORT=3010

# The externally visible base URL, e.g. https://pod.example.com. Used to build
# the Spotify OAuth redirect and the pairing details shown to the local app.
# Leave blank and the app infers it from the request, which is fine for testing.
PUBLIC_URL=

# Set to 1 only when a reverse proxy in front of this app sets X-Forwarded-*.
TRUST_PROXY=0

# ---- Spotify (optional but strongly recommended) --------------------------
# Create an app at https://developer.spotify.com/dashboard
# Client credentials alone enable search + metadata resolution.
# Adding the redirect URI below also enables importing your own playlists.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI registered on the Spotify app exactly.
# Typically: <PUBLIC_URL>/api/import/spotify/callback
SPOTIFY_REDIRECT_URI=

# Optional two-letter market (e.g. GB, IN, US). Leave blank unless a specific
# market gives better matches for your library. Blank means Spotify returns
# everything, which is normally right here: this tool only reads metadata, so
# whether a track is playable in a given country does not matter.
SPOTIFY_MARKET=

# ---- MusicBrainz (fallback provider) --------------------------------------
# MusicBrainz requires a contactable User-Agent. An email or a project URL.
MUSICBRAINZ_CONTACT=

# ---- Resource ceilings ----------------------------------------------------
APP_MEM_LIMIT=512m
DB_MEM_LIMIT=512m
DB_SHM_SIZE=256m
